--- !u!114 &361635578
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 361635574}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 520b57938ba69804a80cc749a79820c3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  playOnStart: 1
  lines:
  - speaker: Aside
    text: Three months later, the old man <b>passed away</b>.
    speed: 0.8
    pitch: 0.92
    blip: {fileID: 0}
  - speaker: Aside
    text: His family placed the <b>portrait</b> in the ancestral hall.
    speed: 0.88
    pitch: 0.96
    blip: {fileID: 0}
  - speaker: Aside
    text: People began to whisper that the dead man had claimed the child's <b>shadow</b>.
    speed: 0.75
    pitch: 0.9
    blip: {fileID: 0}
  - speaker: Aside
    text: They said he would <b>return for her</b> after his burial.
    speed: 0.8
    pitch: 0.91
    blip: {fileID: 0}
  - speaker: Aside
    text: I didn't want to believe them.
    speed: 0.85
    pitch: 0.94
    blip: {fileID: 0}
  - speaker: Aside
    text: <pause=0.3>But I was <b>too afraid</b> not to.
    speed: 0.76
    pitch: 0.9
    blip: {fileID: 0}
  lineBackgrounds:
  - {fileID: -5343259920873876913, guid: e73fb2044a9694dcc8fe7071f9dd441b, type: 3}
  - {fileID: 0}
  linePortraits:
  - {fileID: 0}
  - {fileID: -7391809670129946668, guid: c55b1b472fbaf419cace4b5dce5bd8d2, type: 3}
  - {fileID: 8241063192178853629, guid: b27df3f63a6b83440956ad90b846bec6, type: 3}
  - {fileID: 8241063192178853629, guid: b27df3f63a6b83440956ad90b846bec6, type: 3}
