  m_Script: {fileID: 11500000, guid: 520b57938ba69804a80cc749a79820c3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  playOnStart: 1
  lines:
  - speaker: Aside
    text: There was an old story in our village.
    speed: 1
    pitch: 1
    blip: {fileID: 0}
  - speaker: Aside
    text: Long ago, we had only one photographer.
    speed: 1
    pitch: 1
    blip: {fileID: 0}
  - speaker: Aside
    text: 'Every year, he came to the ancestral hall to take

      portraits.'
    speed: 1
    pitch: 1
    blip: {fileID: 0}
  - speaker: Aside
    text: 'Many elderly had their portraits taken in advance,

      to be used after
      their passing'
    speed: 1
    pitch: 1
    blip: {fileID: 0}
  - speaker: Aside
    text: "... But one year, something strange happened\u2026"
    speed: 1
    pitch: 1
    blip: {fileID: 0}
  lineBackgrounds:
  - {fileID: -5343259920873876913, guid: e73fb2044a9694dcc8fe7071f9dd441b, type: 3}
  linePortraits:
