  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5a08e98e3fbbe48639bfb9473f6aac25, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - speaker: Me
    text: I carefully <b>pull the cloth away</b>.
    speed: 0.85
    pitch: 0.95
    blip: {fileID: 0}
  - speaker: Me
    text: <pause=0.3><size=120%><b>What?</b></size>
    speed: 0.8
    pitch: 1.05
    blip: {fileID: 0}
  - speaker: Me
    text: There's <b>someone behind him</b>.
    speed: 0.75
    pitch: 0.9
    blip: {fileID: 0}
  - speaker: Me
    text: A <b>little girl</b>?
    speed: 0.8
    pitch: 1.05
    blip: {fileID: 0}
  - speaker: Me
    text: <pause=0.25>But why does she look so <b>familiar</b>?
    speed: 0.85
    pitch: 0.96
    blip: {fileID: 0}
  secondLines: []
  secondOverlay: {fileID: 0}
  secondSwapSprite: {fileID: 0}
  onInteract:
    m_PersistentCalls:
      m_Calls: []
  onlyOnce: 1
  logOnClick: 1
  worldBackground: {fileID: 0}
  uiBackground: {fileID: 0}
  swapSprite: {fileID: 0}
  swapResourceName: BackGrounds/fish_eye
  holdSeconds: 2
